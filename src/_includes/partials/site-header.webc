<header role="banner">
  <nav aria-label="Primary navigation">
    <ul role="list">
      <li webc:for="item of $data.navigation.header">
        <a
          :href="item.url"
          :aria-current="$data.helpers.getCurrentPage(item.url, $data.page.url)"
          @text="item.text"
        ></a>
      </li>
    </ul>
  </nav>
</header>
