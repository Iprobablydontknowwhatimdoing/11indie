<footer role="contentinfo">
  <h-card></h-card>
  <nav aria-label="Footer navigation">
    <ul class="cluster" role="list">
      <li webc:for="item in $data.navigation.footer">
        <a
          :href="item.url"
          :aria-current="$data.helpers.getCurrentPage(item.url, $data.page.url)"
          :@text="item.text"
        ></a>
      </li>
    </ul>
  </nav>
  <p>&copy; elliot //TODO</p>
</footer>
