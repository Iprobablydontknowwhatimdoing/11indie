<article class="h-entry">
  <h-entry-meta />
  <section class="e-content">
    <slot>
      Whoops! Nothing Here.
    </slot>
  </section>
  <aside role="note">
    Posted
    <time class="dt-published" :datetime="toISOString(date)" :@text="`formatDate(date)`"></time>.
  </aside>

  <a class="u-url" :href="meta.url + page.url">Permalink</a>
  <a class="p-author h-card" :href="meta.url" :@text="meta.author.name"></a>
  <h-entry-interactions @id="entry-interactions"></h-entry-interactions>
</article>