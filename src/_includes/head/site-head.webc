<title
  @text="title ? `${title} | ${$data.meta.siteName}` : $data.meta.siteName"
></title>
<template webc:is="meta-info" webc:nokeep></template>
<template webc:is="indie-web" webc:nokeep></template>
<template webc:is="css-link" webc:nokeep></template>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
